{{/* The fields of the features of a class: lines built in Go. */}}
{{ define "impl/members.fields" -}}
{{ lines . }}
{{- end }}

{{/* The constructor: the initialization of the fields, lines built in Go. */}}
{{ define "impl/members.constructor" -}}
constructor() {
    super()
{{- range . }}
    {{ . }}
{{- end }}
}
{{- end }}

{{/* The meta object of the class. */}}
{{ define "impl/members.staticclass" -}}
eStaticClass(): {{ .Ecore "EClass" }} {
    return {{ .Getter }}().{{ .ClassGetter }}()
}
{{- end }}

{{/* With a reflective delegation the store holds every feature. */}}
{{ define "impl/members.staticfeaturecount" -}}
eStaticFeatureCount(): number {
    return 0
}
{{- end }}

{{/* The factory of the implementation of a shared package. */}}
{{ define "impl/members.efactory" -}}
// the factory of the implementation of this object
eFactory(): {{ .Ecore "EFactory" }} {
    return {{ .GetFactory }}()
}
{{- end }}

{{/* The generic getter of a map entry key or value, when renamed. */}}
{{ define "impl/members.mapentryget" -}}
get{{ .Upper }}(): {{ .Type }} {
    return this.{{ .Getter }}()
}
{{- end }}

{{/* The generic setter of a map entry key or value, when renamed. */}}
{{ define "impl/members.mapentryset" -}}
set{{ .Upper }}({{ .Name }}: {{ .Type }}) {
{{- if .IsList }}
    const l = this.{{ .Getter }}()
    l.clear()
    l.addAll({{ .Name }})
{{- else }}
    this.{{ .Setter }}({{ .Name }})
{{- end }}
}
{{- end }}

{{/* The members of a hybrid class (storage=hybrid): eGetFromID reads the typed
     fields by their getters (a reference only when resolving), eClearFields and
     eClearField clear the bits of the fields of the class level. */}}
{{ define "impl/members.hybrid" -}}
eGetFromID(featureID: number, resolve: boolean): any {
    switch (featureID) {
{{- range .Fields }}
        case {{ .ID }}:
{{- if .HybridReference }}
            if (!resolve) {
                break
            }
{{- end }}
            return this.{{ .Getter }}()
{{- end }}
    }
    return super.eGetFromID(featureID, resolve)
}

eClearFields(): void {
{{- range .Masks }}
    this.{{ . }} = 0
{{- end }}
    super.eClearFields()
}

eClearField(featureID: number): void {
    switch (featureID) {
{{- range .Fields }}
        case {{ .ID }}:
            this.{{ .HybridMask }} &= ~{{ .HybridBit }}
            return
{{- end }}
    }
    super.eClearField(featureID)
}
{{- end }}
