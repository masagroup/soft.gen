{{/* eIsSetFromID: whether a feature by id is set: its ESet flag, else whether it differs from its default. */}}
{{ define "reflectives/eisset" -}}
eIsSetFromID(featureID: number): boolean {
    switch (featureID) {
{{- range .Cases }}
        case {{ .CaseID }}: {
            return {{ .Value }}
        }
{{- end }}
        default: {
            return super.eIsSetFromID(featureID)
        }
    }
}
{{- end }}
