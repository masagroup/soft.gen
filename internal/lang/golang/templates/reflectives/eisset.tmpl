{{/* EIsSetFromID: whether a feature is set, by id: its ESet flag, else whether it differs from its default. */}}
{{ define "reflectives/eisset" -}}
func ({{ .Receiver }} *{{ .Impl }}) EIsSetFromID(featureID int) bool {
	switch featureID {
{{- range .Cases }}
	case {{ .ID }}:
		return {{ .Value }}
{{- end }}
	default:
		return {{ .Receiver }}.{{ .ExtendsSimple }}.EIsSetFromID(featureID)
	}
}
{{- end }}
