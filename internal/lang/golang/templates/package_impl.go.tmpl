func (p *{{ $.Name }}) initialize{{ .Identifier }}Annotations(ecoreFactory {{ $.EcoreFactoryType }}) {
	source := "{{ .URI }}"
{{- range .Annotations }}
	{
		eAnnotation := ecoreFactory.CreateEAnnotationFromContainer({{ .Container }})
		eAnnotation.SetSource(source)
{{- range .Details }}
		eAnnotation.GetDetails().Put("{{ .Key }}", "{{ .Value }}")
{{- end }}
	}
{{- end }}
