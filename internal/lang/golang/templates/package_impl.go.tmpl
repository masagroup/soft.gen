func {{ .Constructor }}() *{{ .Name }} {
	p := new({{ .Name }})
	p.SetInterfaces(p)
	p.Initialize({{ .PackageFactory }}, {{ .EcoreFactory }})
	return p
}

func (p *{{ .Name }}) Initialize(packageFactory {{ .PackageFactoryType }}, ecoreFactory {{ .EcoreFactoryType }}) {
	p.EPackageExt.Initialize()
	p.SetName({{ .NameConstant }})
	p.SetNsPrefix({{ .NsPrefixConstant }})
	p.SetNsURI({{ .NsURIConstant }})
	p.SetEFactoryInstance(packageFactory)
	p.createPackageContents(ecoreFactory)
	p.initializePackageContents(ecoreFactory)
	p.CreateResource()
}
