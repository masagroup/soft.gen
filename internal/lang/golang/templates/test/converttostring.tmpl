{{/* The test of the conversion of a data type value to a string, by kind (v1 generateConvertTo). */}}
{{ define "test/converttostring.enum" -}}
	{
		mockEDataType := {{ .MockEDataType }}(t)
		mockEDataType.EXPECT().GetClassifierID().Return({{ .ID }}).Times({{ .Times }})
		{{ .Assert }}Equal(t, "", factory.ConvertToString(mockEDataType, nil))
{{- range .Literals }}
		{{ $.Assert }}Equal(t, "{{ .Name }}", factory.ConvertToString(mockEDataType, {{ .Const }}))
{{- end }}
		mockEDataType.AssertExpectations(t)
	}
{{- end }}

{{ define "test/converttostring.string" -}}
	{
		mockEDataType := {{ .MockEDataType }}(t)
		mockEDataType.EXPECT().GetClassifierID().Return({{ .ID }})
		{{ .Assert }}Equal(t, "test", factory.ConvertToString(mockEDataType, "test"))
		mockEDataType.AssertExpectations(t)
	}
{{- end }}

