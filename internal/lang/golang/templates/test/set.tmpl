{{ define "test/set.reflectivecontainer" -}}
func Test{{ .Class }}{{ .Name }}Set(t *{{ .T }}) {
	// object
	o := {{ .Constructor }}()

	// add listener
	mockAdapter := {{ .Ecore }}NewMockEAdapter(t)
	mockAdapter.EXPECT().SetTarget(o).Once()
	o.EAdapters().Add(mockAdapter)
	{{ .Mock }}AssertExpectationsForObjects(t, mockAdapter)

	// set with the mock value
	mockValue := {{ .TestValue }}
	mockResource := {{ .Ecore }}NewMockEResource(t)
	mockClass := {{ .Ecore }}NewMockEClass(t)
	mockValue.EXPECT().EClass().Return(mockClass).Once()
	mockClass.EXPECT().GetFeatureID({{ .ReverseGetter }}).Return({{ .ReverseID }}).Once()
	mockValue.EXPECT().EInverseAdd(o, {{ .ReverseID }}, nil).Return(nil).Once()
	mockValue.EXPECT().EResource().Return(mockResource).Once()
	mockResource.EXPECT().Attached(o).Once()
	mockAdapter.EXPECT().NotifyChanged({{ .Mock }}Anything).Once()
	o.{{ .Setter }}(mockValue)
	{{ .Mock }}AssertExpectationsForObjects(t, mockAdapter, mockClass, mockValue, mockResource, mockClass)

	// set with the same mock value
	mockAdapter.EXPECT().NotifyChanged({{ .Mock }}Anything).Once()
	o.{{ .Setter }}(mockValue)
	{{ .Mock }}AssertExpectationsForObjects(t, mockAdapter, mockClass, mockValue, mockResource)

	// another value - in a different resource
	mockValue2 := {{ .TestValue }}
	mockResource2 := {{ .Ecore }}NewMockEResource(t)
	mockValue.EXPECT().EClass().Return(mockClass).Once()
	mockClass.EXPECT().GetFeatureID({{ .ReverseGetter }}).Return({{ .ReverseID }}).Once()
	mockValue.EXPECT().EInverseRemove(o, {{ .ReverseID }}, nil).Return(nil).Once()
	mockValue.EXPECT().EResource().Return(mockResource).Once()
	mockValue2.EXPECT().EClass().Return(mockClass).Once()
	mockClass.EXPECT().GetFeatureID({{ .ReverseGetter }}).Return({{ .ReverseID }}).Once()
	mockValue2.EXPECT().EInverseAdd(o, {{ .ReverseID }}, nil).Return(nil).Once()
	mockValue2.EXPECT().EResource().Return(mockResource2).Once()
	mockResource.EXPECT().Detached(o).Once()
	mockResource2.EXPECT().Attached(o).Once()
	mockAdapter.EXPECT().NotifyChanged({{ .Mock }}Anything).Once()
	o.{{ .Setter }}(mockValue2)
	{{ .Mock }}AssertExpectationsForObjects(t, mockAdapter, mockClass, mockValue, mockResource, mockValue2, mockResource2)
}
{{- end }}

