{{/* The test of EUnsetFromID (v1 generateEUnSetFromIDTestImplementation): each feature is unset, then read back by variant. */}}
{{ define "test/eunset" -}}
func Test{{ .Class }}EUnsetFromID(t *{{ .T }}) {
	o := {{ .Constructor }}()
	{{ .Assert }}Panics(t, func() { o.EUnsetFromID(-1) })
{{- range .Features }}
	{
{{ include (printf "test/eunset.%s" .EUnsetKind) . }}
	}
{{- end }}
}
{{- end }}

{{ define "test/eunset.volatile" -}}
		{{ .Assert }}Panics(t, func() { o.EUnsetFromID({{ .ID }}) })
{{- end }}

{{ define "test/eunset.list" -}}
		o.EUnsetFromID({{ .ID }})
		v := o.EGetFromID({{ .ID }}, false)
		{{ .Assert }}NotNil(t, v)
		l := v.({{ .Ecore }}EList)
		{{ .Assert }}True(t, l.Empty())
{{- end }}

{{ define "test/eunset.reference" -}}
		o.EUnsetFromID({{ .ID }})
		{{ .Assert }}Nil(t, {{ .ReadBack }})
{{- end }}

{{ define "test/eunset.nil" -}}
		o.EUnsetFromID({{ .ID }})
		v := {{ .ReadBack }}
		{{ .Assert }}Nil(t, v)
{{- end }}

{{ define "test/eunset.value" -}}
		o.EUnsetFromID({{ .ID }})
		v := {{ .ReadBack }}
		{{ .Assert }}Equal(t, {{ .Default }}, v)
{{- end }}

{{ define "test/eunset.none" -}}
		o.EUnsetFromID({{ .ID }})
{{- end }}
