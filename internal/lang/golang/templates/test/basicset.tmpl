{{/* The test of the basic setter of a feature, by variant (v1 generateBasicSetTestImplementation). */}}
{{ define "test/basicset.volatile" -}}
func Test{{ .Class }}{{ .Name }}BasicSet(t *{{ .T }}) {
	o := {{ .Constructor }}()
	mockValue := {{ .TestValue }}
	mockNotifications := {{ .Ecore }}NewMockENotificationChain(t)
	{{ .Assert }}Panics(t, func() { o.{{ .BasicSetter }}(mockValue, mockNotifications) })
}
{{- end }}

{{/* A field: the SET notification joins the chain; a container value is asked for its resource. */}}
{{ define "test/basicset.default" -}}
func Test{{ .Class }}{{ .Name }}BasicSet(t *{{ .T }}) {
	o := {{ .Constructor }}()

	// add listener
	mockAdapter := {{ .Ecore }}NewMockEAdapter(t)
	mockAdapter.EXPECT().SetTarget(o).Once()
	o.EAdapters().Add(mockAdapter)
	{{ .Mock }}AssertExpectationsForObjects(t, mockAdapter)

	mockValue := {{ .TestValue }}
	mockNotifications := {{ .Ecore }}NewMockENotificationChain(t)
{{- if .IsContainer }}
	mockValue.EXPECT().EResource().Return(nil).Once()
{{- end }}
	mockNotifications.EXPECT().Add({{ .Mock }}MatchedBy(func(notification {{ .Ecore }}ENotification) bool {
		return notification.GetEventType() == {{ .Ecore }}SET && notification.GetFeatureID() == {{ .ID }}
	})).Return(true).Once()
	o.{{ .BasicSetter }}(mockValue, mockNotifications)
	{{ .Mock }}AssertExpectationsForObjects(t, mockAdapter, mockValue, mockNotifications)
}
{{- end }}
