{{/* The test of EGetFromID (v1 generateEGetFromIDTestImplementation): each feature case by variant. */}}
{{ define "test/eget" -}}
func Test{{ .Class }}EGetFromID(t *{{ .T }}) {
	o := {{ .Constructor }}()
	{{ .Assert }}Panics(t, func() { o.EGetFromID(-1, true) })
{{- range .Features }}
{{ include (printf "test/eget.%s" .EGetKind) . }}
{{- end }}
}
{{- end }}

{{ define "test/eget.panics" -}}
	{{ .Assert }}Panics(t, func() { o.EGetFromID({{ .ID }}, true) })
	{{ .Assert }}Panics(t, func() { o.EGetFromID({{ .ID }}, false) })
{{- end }}

{{/* A volatile feature with a getterBody: the body is called. */}}
{{ define "test/eget.body" -}}
	{{ .Assert }}NotPanics(t, func() { o.EGetFromID({{ .ID }}, true) })
	{{ .Assert }}NotPanics(t, func() { o.EGetFromID({{ .ID }}, false) })
{{- end }}

{{ define "test/eget.get" -}}
	{{ .Assert }}Equal(t, o.{{ .Getter }}(), o.EGetFromID({{ .ID }}, true))
{{- end }}

{{/* A reference list: the unresolved list is read without resolving. */}}
{{ define "test/eget.list" -}}
	{{ .Assert }}Equal(t, o.{{ .Getter }}(), o.EGetFromID({{ .ID }}, true))
	{{ .Assert }}Equal(t, o.{{ .Getter }}().({{ .Ecore }}EObjectList).GetUnResolvedList(), o.EGetFromID({{ .ID }}, false))
{{- end }}
