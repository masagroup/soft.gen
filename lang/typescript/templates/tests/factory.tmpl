{{/* The conversion of a value of an unknown data type. */}}
{{ define "tests/factory.invalidconvert" -}}
test("convertToStringInvalid", () => {
    const mockDataType = mock<{{ .Ecore "EDataType" }}>()
    const eDataType = instance(mockDataType)
