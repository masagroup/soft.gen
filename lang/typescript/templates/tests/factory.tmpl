{{/* The creation of an object of each class by its class id, and of an unknown class. */}}
{{ define "tests/factory.create" -}}
test("createFromEClass", () => {
    const factory = {{ .Factory }}.getInstance()
    {
        const mockEClass = mock<{{ .Ecore "EClass" }}>()
        const eClass = instance(mockEClass)
        when(mockEClass.getClassifierID()).thenReturn(-1)
        expect(() => factory.create(eClass)).toThrow(Error)
    }
{{- range .Classes }}
    {
        const mockEClass = mock<{{ $.Ecore "EClass" }}>()
        const eClass = instance(mockEClass)
        when(mockEClass.getClassifierID()).thenReturn({{ . }})
        expect(factory.create(eClass)).not.toBeNull()
    }
{{- end }}
})
{{- end }}

{{/* The creator of a class. */}}
{{ define "tests/factory.creator" -}}
test("create{{ .Class }}", () => {
    expect({{ .Factory }}.getInstance().create{{ .Class }}()).not.toBeNull()
})
{{- end }}

{{/* The creator of a class from a container, and its class id. */}}
{{ define "tests/factory.fromcontainer" -}}
test("{{ .Test }}", () => {
    const mockContainer = mock<{{ .Container }}>()
    const container = instance(mockContainer)
{{- if .ContainerList }}
    const mockList = mock<{{ .Ecore "EList" }}<{{ .ContainerList }}>>()
    const list = instance(mockList)
    when(mockList.add(anything())).thenReturn(true)
    when(mockContainer.{{ .ContainerGet }}).thenReturn(list)
{{- end }}
{{- if .WithClassID }}
    expect({{ .Factory }}.getInstance().create{{ .Class }}FromContainerAndClassID(container, 0)).not.toBeNull()
{{- else }}
    expect({{ .Factory }}.getInstance().create{{ .Class }}FromContainer(container)).not.toBeNull()
{{- end }}
})
{{- end }}

