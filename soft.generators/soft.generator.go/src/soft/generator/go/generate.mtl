[comment encoding = UTF-8 /]
[module generate('http://www.eclipse.org/emf/2002/Ecore')/]

[import soft::generator::go::generatePath/]
[import soft::generator::go::lib::generateEnum/]
[import soft::generator::go::lib::generateInterface/]
[import soft::generator::go::lib::generateImplementation/]
[import soft::generator::go::lib::pack::generatePackageInterface/]
[import soft::generator::go::lib::pack::generatePackageImplementation/]
[import soft::generator::go::lib::factory::generateFactoryInterface/]
[import soft::generator::go::lib::factory::generateFactoryImplementation/]
[import soft::generator::go::tests::generateImplementationTests/]
[import soft::generator::go::tests::generateFactoryTests/]
[import soft::generator::go::tests::generateMock/]
[import soft::generator::go::tests::generateMockTests/]
[import soft::generator::go::tests::generatePackageTests/]

[template public generateModel(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass))]
    [aClass.generateInterface()/]
[/for]
[for (anEEnum : EEnum | aPackage.eAllContents(EEnum))]
    [anEEnum.generateEnum()/]
[/for]
[aPackage.generatePackageInterface()/]
[aPackage.generateFactoryInterface()/]
[for (aClass : EClass | aPackage.eAllContents(EClass)->select(not interface))]
    [aClass.generateImplementation()/]
[/for]
[aPackage.generatePackageImplementation()/]
[if aPackage.isSharedPackage()]
[aPackage.generateDataTypeFactory()/]
[/if]
[aPackage.generateFactoryImplementation()/]
[/template]

[**
 * Generates the interfaces of the model: the interfaces of the classes, the enums, and the package
 * and factory interfaces. With an implementation package path distinct from the interface package
 * path (packages property: uri=interface#implementation), the implementation is generated apart by
 * generateImplementations, so several implementations of the model can be generated, each by a run
 * of its own with its options (featureDelegation, rootExtendsClass) and its implementation path,
 * sharing the interfaces generated once. With equal paths, the package and factory instances
 * (GetPackage, GetFactory) are generated with the interfaces.
 * With the property packageInstance=interfaces and distinct paths, the package instance (GetPackage)
 * and a factory of the data types of the model are generated with the interfaces: the
 * implementations share this package and its classes, each one with a factory of its own.
 * generateModel generates both.
 */]
[template public generateInterfaces(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass))]
    [aClass.generateInterface()/]
[/for]
[for (anEEnum : EEnum | aPackage.eAllContents(EEnum))]
    [anEEnum.generateEnum()/]
[/for]
[aPackage.generatePackageInterface()/]
[aPackage.generateFactoryInterface()/]
[if aPackage.isSharedPackage()]
[aPackage.generatePackageImplementation()/]
[aPackage.generateDataTypeFactory()/]
[/if]
[/template]

[**
 * Generates an implementation of the model: the implementations of the classes, the package and the
 * factory, in the implementation package path. With a path distinct from the interface package path,
 * it is a complete implementation, with its package and factory instances (GetPackage, GetFactory).
 * With the property packageInstance=interfaces, the package is the one generated with the
 * interfaces: the implementation holds its classes, whose EClass is the shared one, and its factory
 * (GetFactory), whose package is the shared one.
 * See generateInterfaces.
 */]
[template public generateImplementations(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass)->select(not interface))]
    [aClass.generateImplementation()/]
[/for]
[if not aPackage.isSharedPackage()]
[aPackage.generatePackageImplementation()/]
[/if]
[aPackage.generateFactoryImplementation()/]
[/template]

[template public generateTests(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass))]
	[if not aClass.interface]
		[aClass.generateImplementationTests()/]
	[/if]
[/for]
[aPackage.generateFactoryTests()/]
[aPackage.generatePackageTests()/]
[/template]

[template public generateMocks(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass))]
	[aClass.generateMock()/]
[/for]
[/template]

[template public generateMocksTests(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass))]
	[aClass.generateMockTests()/]
[/for]
[/template]

