[comment encoding = UTF-8 /]
[module generateImplementation('http://www.eclipse.org/emf/2002/Ecore')/]

[import soft::generator::common::generateCommon]
[import soft::generator::common::generateUtils]
[import soft::generator::common::generateElement]
[import soft::generator::common::generateStructuralFeature]

[import soft::generator::ts::generateCommon/]
[import soft::generator::ts::generateElement/]
[import soft::generator::ts::generateModule]
[import soft::generator::ts::generateType/]
[import soft::generator::ts::lib::generateCommon/]
[import soft::generator::ts::lib::generateOperation/]
[import soft::generator::ts::lib::generateReflectives/]
[import soft::generator::ts::lib::generateStructuralFeature/]

[template public generateImplementation(aClass : EClass) {
	aPackage : EPackage = aClass.ePackage; 
    ecorePackage : EPackage = getEcorePackage();  
    className : String = aClass.getImplementationName();
    classExtend : String = aClass.getClassExtends(); 
    classImplement : String = aClass.getQualifiedInterfaceIdentifier();
	features : OrderedSet(EStructuralFeature) = aClass.getImplementedFeatures()->sortedBy( getVariableName() );
    reflectiveDelegation : Boolean = aClass.isReflectiveDelegation();
    variableFeatures : Collection(EStructuralFeature) = if reflectiveDelegation then OrderedSet(EStructuralFeature){} else features->select(isField()) endif;
    initializerFeatures : Collection(EStructuralFeature) = if reflectiveDelegation then OrderedSet(EStructuralFeature){} else features->select(hasInitializationMethod()) endif;
    operations : Collection(EOperation) = aClass.getImplementedOperations()->sortedBy( getOperationName());
    
	types : OrderedSet(String) = Set{ aClass.getReferencedTypes()
											->select( cls | not cls.oclIsTypeOf(EClass) or not cls.oclAsType(EClass).isMapEntry())
											->collect( cls | cls.getType() )->asSet()
									, Set{
										 	if aClass.requiresMap()  then if reflectiveDelegation then Set{'EMap','EMapEntry'} else Set{'EMap','BasicEObjectMap','EMapEntry'} endif else Set{} endif,
											if aClass.requiresList() then if reflectiveDelegation then Set{'EList'} else Set{'EList','BasicEList','BasicEObjectList','BasicEDataTypeList'} endif else Set{} endif,
		 									if aClass.hasReflectives() and not reflectiveDelegation then Set{'EObject','EObjectInternal','EList','ENotifyingList','ENotificationChain','isEObjectList'} else Set{} endif,
											if features->exists(requiresNotification()) and not reflectiveDelegation then Set{'ENotification','ENotificationChain','EventType','Notification','EOPPOSITE_FEATURE_BASE'} else Set{} endif,
											if reflectiveDelegation then Set{'EClass'} else Set{'EClass','isEObjectInternal'} endif
									    }->flatten()->collect(t | ecorePackage.getQualifiedInterfaceIdentifier(t))->asSet()
									, Set {
											aPackage.getConstantsName(),
											'get' + aPackage.getPackageName()
										  }->collect(t | aPackage.getQualifiedInterfaceIdentifier(t))->asSet()
									, if aPackage.isSharedPackage() then
											Set{ aPackage.getQualifiedImplementationIdentifier('getFactory'), ecorePackage.getQualifiedInterfaceIdentifier('EFactory') }
									  else
											Set{}
									  endif
									, Set {
											classImplement,
											classExtend
										  }
									}->flatten()->select(s | s <> '')->asOrderedSet()->sortedBy(s | s);
	modules : OclAny = aClass.getModules('implementation',types);
}]
[file (aPackage.getPackageDirectory() + '/' + aClass.getImplementationFileName( aClass.name ), false, 'UTF-8')]
[fileComment()/]

[if isDebug()]
// module : [aPackage.getImplementationModule()/]
// path : [getModulePath(aPackage.getImplementationModule())/]
// namespace : [getModuleNamespace(aPackage.getImplementationModule())/]

// refs
[for (cls : EClassifier | aClass.getReferencedTypes())]
// [cls.getQualifiedInterfaceIdentifier()/]
[/for]

// types
[for (type : String| types)]
// [type/]
[/for]

// modules
[for (mod : OclAny | modules.mapKeys())]
// [mod/] => [modules.mapGet(mod)/]
[/for]
[/if]


[aClass.generateImports('implementation', types, modules)/]

export class [className/] extends [getImportedIdentifier(classExtend, modules)/] implements [getImportedIdentifier(classImplement,modules)/] {
[if not reflectiveDelegation]
[let dataDeclarationFeatures : OrderedSet(EStructuralFeature) = features->select(isField())->asOrderedSet()->sortedBy(getVariableName())]
    [dataDeclarationFeatures.generateVariableDeclaration(modules)/]
[/let]
[/if]

    constructor() {
        super()
        [variableFeatures.generateVariableInitialization(modules)/]
    }

    eStaticClass(): [if not aPackage.isEcorePackage()]ecore.[/if]EClass {
        return get[aPackage.getInterfaceName()/]().[aClass.getReflectiveGetterName()/]()
    }
[if reflectiveDelegation]

    eStaticFeatureCount(): number {
        return 0
    }
[/if]
[if aPackage.isSharedPackage()]

    // the factory of the implementation of this object
    eFactory(): ecore.EFactory {
        return getFactory()
    }
[/if]

[let properties : OrderedSet(EStructuralFeature) = features->select( isPropertyAccessors() and (isGet() or isSet()))]
	[properties.generatePropertyImplementation(aClass,modules)/]	
[/let]

[if aClass.isMapEntry()]
[let keyFeature : EStructuralFeature = aClass.getEStructuralFeature('key')]
[let valueFeature : EStructuralFeature = aClass.getEStructuralFeature('value')]
[if keyFeature.getGetterName() <> 'getKey']
	getKey() : [keyFeature.generateType(modules)/] {
    	return this.[keyFeature.getGetterName()/]()
	}
[/if]
[if keyFeature.getSetterName() <> 'setKey']
	setKey(key:  [keyFeature.generateType(modules)/]) {
[if keyFeature.isListType()]
		const l = this.[keyFeature.getGetterName()/]()
		l.clear() 
		l.addAll(key)
[else]
    	this.[keyFeature.getSetterName()/](key)
[/if]
	}
[/if]
[if valueFeature.getGetterName() <> 'getValue']
	getValue():  [valueFeature.generateType(modules)/] {
    	return this.[valueFeature.getGetterName()/]()
	}
[/if]
[if valueFeature.getSetterName() <> 'setValue']
	setValue(value: [valueFeature.generateType(modules)/]) {
[if valueFeature.isListType()]
		const l = this.[valueFeature.getGetterName()/]()
		l.clear()
		l.addAll(value)
[else]
    	this.[valueFeature.getSetterName()/](value)
[/if]
	}
[/if]
[/let]
[/let]
[/if]

    [features.generateMethodsImplementation(aClass,modules)/]

    [operations.generateImplementation(aClass,modules)/]

    [initializerFeatures.generateVariableInitializationMethodDefinition(aClass,modules)/]

    [aClass.generateReflectivesDefinition(modules)/]
}

[/file]
[/template]