[comment encoding = UTF-8 /]
[module generate('http://www.eclipse.org/emf/2002/Ecore')/]

[import soft::generator::ts::lib::generateModule/]
[import soft::generator::ts::lib::generateEnum/]
[import soft::generator::ts::lib::generateInterface/]
[import soft::generator::ts::lib::generateImplementation/]
[import soft::generator::ts::lib::factory::generateFactoryInterface/]
[import soft::generator::ts::lib::factory::generateFactoryImplementation/]
[import soft::generator::ts::lib::pack::generatePackageConstants/]
[import soft::generator::ts::lib::pack::generatePackageImplementation/]
[import soft::generator::ts::lib::pack::generatePackageInterface/]
[import soft::generator::ts::tests::generateImplementationTests/]
[import soft::generator::ts::lib::generateCommon/]
[import soft::generator::ts::tests::generateFactoryTests/]
[import soft::generator::ts::generateModule/]


[template public generateModel(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass))]
    [aClass.generateInterface()/]
	[if not aClass.interface]	
    	[aClass.generateImplementation()/]
	[/if]
[/for]
[for (anEEnum : EEnum | aPackage.eAllContents(EEnum))]
    [anEEnum.generateEnum()/]
[/for]
[aPackage.generateFactoryInterface()/]
[aPackage.generateFactoryImplementation()/]
[aPackage.generatePackageConstants()/]
[aPackage.generatePackageInterface()/]
[aPackage.generatePackageImplementation()/]
[/template]

[**
 * Generates the interfaces of the model: the interfaces of the classes, the enums, the constants, and
 * the package and factory interfaces. With the property packageInstance=interfaces and an implementation
 * module distinct from the interface module (packages property: uri=interface#implementation), the package
 * instance (getXPackage), a factory of the data types of the model and the module files (internal, index)
 * are generated with the interfaces: the implementations share this package and its classes, each one
 * with a factory of its own, generated apart by generateImplementations.
 */]
[template public generateInterfaces(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass))]
    [aClass.generateInterface()/]
[/for]
[for (anEEnum : EEnum | aPackage.eAllContents(EEnum))]
    [anEEnum.generateEnum()/]
[/for]
[aPackage.generateFactoryInterface()/]
[aPackage.generatePackageConstants()/]
[aPackage.generatePackageInterface()/]
[if aPackage.isSharedPackage()]
[aPackage.generatePackageImplementation()/]
[aPackage.generateDataTypeFactory()/]
[aPackage.generateInterfacesInternal()/]
[aPackage.generateInterfacesIndex()/]
[/if]
[/template]

[**
 * Generates an implementation of the model: the implementations of the classes and the factory. With
 * the property packageInstance=interfaces, the package is the one generated with the interfaces : the
 * implementation holds its classes, whose EClass is the shared one, its factory, whose package is the
 * shared one, a getFactory() function, an install(registry) function registering the package and the
 * factory in a package registry, and its module files (internal, index). The path of the interfaces
 * module is given by the paths property (e.g. paths=tournament=../internal.js).
 * See generateInterfaces.
 */]
[template public generateImplementations(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass)->select(not interface))]
    [aClass.generateImplementation()/]
[/for]
[aPackage.generateFactoryImplementation()/]
[if aPackage.isSharedPackage()]
[aPackage.generateImplementationsInternal()/]
[aPackage.generateImplementationsIndex()/]
[else]
[aPackage.generatePackageImplementation()/]
[/if]
[/template]

[template public generateModule(aPackage : EPackage)]
[comment @main/]
[aPackage.generateInternal()/]
[aPackage.generateIndex()/]
[/template]


[template public generateTests(aPackage : EPackage)]
[comment @main/]
[for (aClass : EClass | aPackage.eAllContents(EClass))]
	[if not aClass.interface and not aClass.isReflectiveDelegation()]
		[aClass.generateImplementationTests()/]
	[/if]
[/for]
[aPackage.generateFactoryTests()/]
[/template]
